# ---------------------------------------------------------------------------
# Copy to .env.local (development) or set in your hosting provider (production).
# Variables without NEXT_PUBLIC_ are server-only and never reach the browser.
# ---------------------------------------------------------------------------

# Public, canonical URL of the site — used for canonical links, sitemap, robots
# and social images. No trailing slash. Falls back to the Vercel production URL,
# then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Contact form email delivery -------------------------------------------
# Provider: resend | postmark | console. Optional — inferred from whichever key
# is set. With nothing configured, development logs enquiries to the terminal;
# production returns an error instead of pretending to send.
EMAIL_PROVIDER=

# Resend (https://resend.com) — create an API key and verify your sending domain.
RESEND_API_KEY=

# Postmark (https://postmarkapp.com) — server API token.
POSTMARK_SERVER_TOKEN=

# Where enquiries are delivered (comma-separated for several recipients).
CONTACT_TO_EMAIL=
# Sender address on a domain verified with your provider, e.g. "Website <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=

# --- Optional: Cloudflare Turnstile spam protection ------------------------
# Set both to enable the challenge on the enquiry form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
